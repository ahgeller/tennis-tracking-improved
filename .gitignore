__pycache__/
*.py[cod]
output/
AiFolder/
.venv/

# fine-tuning workspace: videos, caches, runs and drafts are regenerable; own labels are kept
finetune/videos/
finetune/cache/
finetune/runs/
finetune/models/*
finetune/labels/*.draft
finetune/labels/*.review.json
finetune/labels/label_tool.settings.json
finetune/labels/*.tmp
finetune/labels/tnv2_*
finetune/labels/grid_*
# landing labels are hand-made and small: kept for every clip, whatever its source
!finetune/labels/*_bounces.csv
# the prof set (public TrackNet tennis) imports as video13..video53 to sit under video12 in the
# clip lists, so the own-labels rule cannot tell it apart by name: spell the range out instead.
finetune/labels/video1[3-9]_ball.csv
finetune/labels/video[2-5][0-9]_ball.csv
finetune/.training-python

# Label safety copies and local source media; already tracked samples stay tracked.
/finetune/labels/*.before_*
/finetune/labels/*.premisaligned
/system/sample/*.mp4
.desloppify/
scorecard.png
.claude/worktrees/
.claude/skills/desloppify/

# model weights are proprietary: kept locally, never committed (system/.gitignore, main's, says
# the same inside system/; promotion's backups sit beside the weights)
/system/models/*
!/system/models/README.md
*.pt
*.pth
*.npz
*.engine
*.onnx
*.cbm
